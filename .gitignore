# Track core code, runtime configuration, and public project documentation.
/*
!/.gitignore
!/pyproject.toml
!/README.md
!/assets/
/assets/*
!/assets/architecture.png
!/assets/results.png
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
!/src/
!/configs/
!/demo/
!/docs/
/demo/output/
/demo/environments/external/
/demo/media/*.webm
__pycache__/
*.py[cod]
*.so
*.egg-info/
.env
.env.*
*credentials*
auth.json
*.pem
*.key
*token*
*.log
*.jsonl
*.pt
*.pth
*.safetensors
/src/jev_spawn/configs/*
!/src/jev_spawn/configs/*.json
/configs/*
!/configs/shared.yaml
