{
  "stage": "qualification",
  "method": "jevspawn",
  "world_size": 4,
  "idle_memory_mib": 100,
  "stop_on_failure": true,
  "occupancy_command": [
    "nvidia-smi",
    "--id=0,1,2,3",
    "--query-gpu=memory.used",
    "--format=csv,noheader,nounits"
  ],
  "entries": [
    {
      "method": "jevspawn",
      "dataset": "ppnl_roots8_reference",
      "specification": "tests/infra/native_rollout_profile/config/ppnl_8_spec.json",
      "run": "runs/native-finite-fences-stage068-ppnl8-reference",
      "evaluation": "results/infra/native-finite-fences-stage068-ppnl8-reference_evaluation.json",
      "progress": "results/infra/native-finite-fences-stage068-ppnl8-reference_progress.json",
      "log": "logs/infra/native-finite-fences-stage068-ppnl8-reference.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_finite_fences/launch.sh",
          "tests/infra/native_finite_fences/reference.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-finite-fences-stage068-ppnl8-reference",
          "--output",
          "results/infra/native-finite-fences-stage068-ppnl8-reference_evaluation.json"
        ]
      ]
    },
    {
      "method": "jevspawn",
      "dataset": "ppnl_roots8_unfenced",
      "specification": "tests/infra/native_rollout_profile/config/ppnl_8_spec.json",
      "run": "runs/native-finite-fences-stage068-ppnl8-unfenced",
      "evaluation": "results/infra/native-finite-fences-stage068-ppnl8-unfenced_evaluation.json",
      "progress": "results/infra/native-finite-fences-stage068-ppnl8-unfenced_progress.json",
      "log": "logs/infra/native-finite-fences-stage068-ppnl8-unfenced.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_finite_fences/launch.sh",
          "tests/infra/native_finite_fences/unfenced.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-finite-fences-stage068-ppnl8-unfenced",
          "--output",
          "results/infra/native-finite-fences-stage068-ppnl8-unfenced_evaluation.json"
        ]
      ]
    }
  ]
}
