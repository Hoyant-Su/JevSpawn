{
  "module": "baselines.common.foldagent",
  "python_paths": [],
  "prompts": "configs/baselines/common/schema/foldagent.json",
  "settings": {
    "source_directory": "external/FoldAgent/agents",
    "max_sessions": 10,
    "minimum_completion_tokens": 10,
    "history_cache": {
      "zero": 0,
      "position_step": 1,
      "row_step": 1,
      "exclude_last": -1,
      "last_index": -1,
      "first_index": 0,
      "minimum_rows": 1,
      "record_offset": 1,
      "cache": {
        "initial_bytes": 0,
        "max_entries": 128,
        "max_bytes": 8589934592
      },
      "state_copy": {
        "mode": "triton_grouped",
        "block_size": 4096,
        "num_warps": 4
      }
    },
    "session_token_budget": 6144,
    "control_iterations": 36
  },
  "service": "baselines.common.unified_service.UnifiedInferenceService"
}
