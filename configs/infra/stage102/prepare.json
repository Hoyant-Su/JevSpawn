{
  "shared_config": "configs/shared_config_tp4_v2.yaml",
  "labels": "configs/jevspawn/readout_labels.json",
  "chat_template": {
    "tokenize": false,
    "add_generation_prompt": true,
    "enable_thinking": false
  },
  "parallel_settings": "configs/jevspawn/qwen35_parallel.json",
  "devices": [
    0,
    1,
    2,
    3
  ],
  "finite_new_tokens": 1,
  "workload_fields": [
    "computed_input_tokens",
    "padded_input_tokens",
    "graph_replays",
    "graph_captures",
    "batch_size",
    "logical_field_count",
    "elapsed_seconds",
    "reused_state_tokens"
  ],
  "rank_file": "rank-{rank}.json",
  "allocator": "expandable_segments:True",
  "entrypoint": "tests/infra/shared_prefix/replay.py",
  "output": "results/infra/history-cache-cause-stage102",
  "prepared": "results/infra/history-cache-cause-stage102/prepared_all.json",
  "repetitions": 3,
  "modes": [
    "recompute",
    "reuse"
  ],
  "rank_ids": [
    0,
    1,
    2,
    3
  ],
  "summary_file": "summary.json",
  "implementations": {
    "recompute": {
      "module": "jev_spawn.infra.stable_finite_graph",
      "class": "StableFiniteGraphTail",
      "caches": [
        "prefix_cache"
      ]
    },
    "reuse": {
      "module": "tests.infra.shared_prefix.runtime",
      "class": "SharedPrefixTail",
      "caches": [
        "prefix_cache",
        "shared_cache"
      ]
    }
  },
  "batch_count": 2,
  "scalar_pairs": [
    [
      "frontier_request",
      "frontier_decision"
    ],
    [
      "operation_request",
      "operation_decision"
    ]
  ],
  "task_pattern": "task-*.json",
  "operation": "finite",
  "coverage": "results/infra/history-cache-cause-stage102/coverage.json",
  "scope": "First two real finite cohorts from each paired Maze trace, preserving task identity, messages, tokens, candidate IDs, and cohort order for causal numerical diagnosis.",
  "sources": [
    {
      "track": "reference",
      "run": "runs/native-history-prefix-stage101/lmrlgym_maze/current_reference",
      "batches": "runs/native-history-prefix-stage101/lmrlgym_maze/current_reference/session-0000/batches.json"
    },
    {
      "track": "history",
      "run": "runs/native-history-prefix-stage101/lmrlgym_maze/current_history",
      "batches": "runs/native-history-prefix-stage101/lmrlgym_maze/current_history/session-0000/batches.json"
    }
  ],
  "terminal_kind": "terminal_finite",
  "request_fields": {
    "history": ""
  }
}
