{
  "idle_memory_mib": 100,
  "stop_on_failure": true,
  "stage": "stage105_production_history_rollout",
  "world_size": 4,
  "occupancy_command": [
    "nvidia-smi",
    "--id=0,1,2,3",
    "--query-gpu=memory.used",
    "--format=csv,noheader,nounits"
  ],
  "instance": "v26-v0801-4-core",
  "entries": [
    {
      "dataset": "lmrlgym_maze",
      "method": "production_history",
      "specification": "configs/infra/stage105/lmrlgym_maze_spec.json",
      "run": "runs/production-history-stage105/lmrlgym_maze",
      "evaluation": "results/validation/production-history-stage105/lmrlgym_maze.json",
      "progress": "results/validation/production-history-stage105/progress/lmrlgym_maze.json",
      "log": "logs/qualification/production-history-stage105/lmrlgym_maze.log",
      "commands": [
        [
          "../../environ/qwen35_spawn/bin/python",
          "scripts/native_baselines/infer_devices.py",
          "--specification",
          "configs/infra/stage105/lmrlgym_maze_spec.json",
          "--output",
          "runs/production-history-stage105/lmrlgym_maze",
          "--devices",
          "0,1,2,3",
          "--parallel-settings",
          "configs/jevspawn/qwen35_parallel.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/production-history-stage105/lmrlgym_maze",
          "--output",
          "results/validation/production-history-stage105/lmrlgym_maze.json"
        ]
      ]
    },
    {
      "dataset": "llfbench_gridworld",
      "method": "production_history",
      "specification": "configs/infra/stage105/llfbench_gridworld_spec.json",
      "run": "runs/production-history-stage105/llfbench_gridworld",
      "evaluation": "results/validation/production-history-stage105/llfbench_gridworld.json",
      "progress": "results/validation/production-history-stage105/progress/llfbench_gridworld.json",
      "log": "logs/qualification/production-history-stage105/llfbench_gridworld.log",
      "commands": [
        [
          "../../environ/qwen35_spawn/bin/python",
          "scripts/native_baselines/infer_devices.py",
          "--specification",
          "configs/infra/stage105/llfbench_gridworld_spec.json",
          "--output",
          "runs/production-history-stage105/llfbench_gridworld",
          "--devices",
          "0,1,2,3",
          "--parallel-settings",
          "configs/jevspawn/qwen35_parallel.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/production-history-stage105/llfbench_gridworld",
          "--output",
          "results/validation/production-history-stage105/llfbench_gridworld.json"
        ]
      ]
    }
  ]
}
