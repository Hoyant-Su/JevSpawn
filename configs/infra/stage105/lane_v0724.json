{
  "idle_memory_mib": 100,
  "stop_on_failure": true,
  "stage": "stage105_production_history_rollout",
  "world_size": 4,
  "occupancy_command": [
    "nvidia-smi",
    "--id=0,1,2,3",
    "--query-gpu=memory.used",
    "--format=csv,noheader,nounits"
  ],
  "instance": "v26-v0725-4-core",
  "entries": [
    {
      "dataset": "ppnl",
      "method": "production_history",
      "specification": "configs/infra/stage105/ppnl_spec.json",
      "run": "runs/production-history-stage105/ppnl",
      "evaluation": "results/validation/production-history-stage105/ppnl.json",
      "progress": "results/validation/production-history-stage105/progress/ppnl.json",
      "log": "logs/qualification/production-history-stage105/ppnl.log",
      "commands": [
        [
          "../../environ/qwen35_spawn/bin/python",
          "scripts/native_baselines/infer_devices.py",
          "--specification",
          "configs/infra/stage105/ppnl_spec.json",
          "--output",
          "runs/production-history-stage105/ppnl",
          "--devices",
          "0,1,2,3",
          "--parallel-settings",
          "configs/jevspawn/qwen35_parallel.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/production-history-stage105/ppnl",
          "--output",
          "results/validation/production-history-stage105/ppnl.json"
        ]
      ]
    },
    {
      "dataset": "robotouille",
      "method": "production_history",
      "specification": "configs/infra/stage105/robotouille_spec.json",
      "run": "runs/production-history-stage105/robotouille",
      "evaluation": "results/validation/production-history-stage105/robotouille.json",
      "progress": "results/validation/production-history-stage105/progress/robotouille.json",
      "log": "logs/qualification/production-history-stage105/robotouille.log",
      "commands": [
        [
          "../../environ/qwen35_spawn/bin/python",
          "scripts/native_baselines/infer_devices.py",
          "--specification",
          "configs/infra/stage105/robotouille_spec.json",
          "--output",
          "runs/production-history-stage105/robotouille",
          "--devices",
          "0,1,2,3",
          "--parallel-settings",
          "configs/jevspawn/qwen35_parallel.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/production-history-stage105/robotouille",
          "--output",
          "results/validation/production-history-stage105/robotouille.json"
        ]
      ]
    }
  ]
}
