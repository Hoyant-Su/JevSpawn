{
  "stage": "stage077_history_cache",
  "method": "jevspawn",
  "world_size": 4,
  "idle_memory_mib": 100,
  "stop_on_failure": true,
  "occupancy_command": [
    "nvidia-smi",
    "--id=0,1,2,3",
    "--query-gpu=memory.used",
    "--format=csv,noheader,nounits"
  ],
  "entries": [
    {
      "method": "jevspawn",
      "dataset": "ppnl",
      "specification": "configs/experiments/native_screen/ppnl_jevspawn.json",
      "run": "runs/native-history-cache-stage077/ppnl",
      "evaluation": "results/validation/native-history-cache-stage077/ppnl.json",
      "progress": "results/validation/native-history-cache-stage077/progress/ppnl.json",
      "log": "logs/qualification/native-history-cache-stage077-ppnl.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_direct_finite/launch.sh",
          "configs/infra/stage077/ppnl.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-history-cache-stage077/ppnl",
          "--output",
          "results/validation/native-history-cache-stage077/ppnl.json"
        ]
      ]
    },
    {
      "method": "jevspawn",
      "dataset": "plancraft",
      "specification": "configs/experiments/native_screen/plancraft_jevspawn.json",
      "run": "runs/native-history-cache-stage077/plancraft",
      "evaluation": "results/validation/native-history-cache-stage077/plancraft.json",
      "progress": "results/validation/native-history-cache-stage077/progress/plancraft.json",
      "log": "logs/qualification/native-history-cache-stage077-plancraft.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_direct_finite/launch.sh",
          "configs/infra/stage077/plancraft.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-history-cache-stage077/plancraft",
          "--output",
          "results/validation/native-history-cache-stage077/plancraft.json"
        ]
      ]
    }
  ]
}
