      "progress": "results/validation/native-joint-control-stage086/progress/lmrlgym_maze_joint.json",
      "log": "logs/qualification/native-joint-control-stage086-lmrlgym_maze-joint.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_chunk_checkpoint/launch.sh",
          "configs/infra/stage086/lmrlgym_maze_joint.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-joint-control-stage086/lmrlgym_maze/joint",
          "--output",
          "results/validation/native-joint-control-stage086/lmrlgym_maze/joint.json"
        ]
      ]
    }
  ]
