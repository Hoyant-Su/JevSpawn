      "progress": "results/validation/native-joint-control-stage086/progress/ppnl_joint.json",
      "log": "logs/qualification/native-joint-control-stage086-ppnl-joint.log",
      "commands": [
        [
          "bash",
          "tests/infra/native_chunk_checkpoint/launch.sh",
          "configs/infra/stage086/ppnl_joint.json"
        ],
        [
          "../../environ/qwen35_spawn/bin/python",
          "-m",
          "baselines.common.evaluate",
          "--run",
          "runs/native-joint-control-stage086/ppnl/joint",
          "--output",
          "results/validation/native-joint-control-stage086/ppnl/joint.json"
        ]
      ]
    },
    {
      "method": "jevspawn",
      "dataset": "lmrlgym_maze",
