{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker",
    "reduce"
  ],
  "properties": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "question",
        "options"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "oneOf": [
            {
              "$ref": "#/$defs/candidates"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_path"
              ],
              "properties": {
                "input_path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "reduce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "score_option"
      ],
      "properties": {
        "operator": {
          "enum": [
            "rank",
            "collect"
          ]
        },
        "score_option": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
